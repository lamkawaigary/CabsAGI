rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function uid() {
      return request.auth.uid;
    }
    
    // ========== USERS ==========
    
    match /users/{userId} {
      allow read: if isAuthenticated() && uid() == userId;
      allow write: if isAuthenticated() && uid() == userId;
    }
    
    // ========== TRIPS ==========
    
    match /trips/{tripId} {
      allow read: if isAuthenticated() && 
        (resource.data.status == 'OPEN' || resource.data.driverId == uid());
      allow create: if isAuthenticated() && request.resource.data.driverId == uid();
      allow update, delete: if isAuthenticated() && resource.data.driverId == uid();
    }
    
    // ========== PASSENGER REQUESTS ==========
    
    match /passengerRequests/{requestId} {
      allow read: if isAuthenticated() && 
        (resource.data.status == 'OPEN' || resource.data.passengerId == uid());
      allow create: if isAuthenticated() && request.resource.data.passengerId == uid();
      allow update, delete: if isAuthenticated() && resource.data.passengerId == uid();
    }
    
    // ========== CHAT ROOMS ==========
    
    match /chatRooms/{roomId} {
      allow read: if isAuthenticated() && 
        (uid() in resource.data.participantIds || 
         uid() == resource.data.participants[0].oderId ||
         uid() == resource.data.participants[1].oderId);
      allow create: if isAuthenticated() && 
        (request.resource.data.participantIds[0] == uid() ||
         request.resource.data.participantIds[1] == uid());
      allow update: if isAuthenticated() && 
        (uid() in resource.data.participantIds || 
         uid() == resource.data.participants[0].oderId ||
         uid() == resource.data.participants[1].oderId);
      allow delete: if false;
    }
    
    // ========== CHAT MESSAGES ==========
    
    match /chatMessages/{messageId} {
      // User can read if their uid is in participantIds array (stored in each message)
      allow read: if isAuthenticated() && uid() in resource.data.participantIds;
      allow create: if isAuthenticated() && request.resource.data.senderId == uid();
      allow update, delete: if false;
    }
  }
}
