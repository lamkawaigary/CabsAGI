rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========== HELPER FUNCTIONS ==========
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function uid() {
      return request.auth.uid;
    }
    
    // Check if user is in participants list
    function isInParticipants(userId, participants) {
      return participants.size() > 0 && 
        (participants[0].oderId == userId || participants[1].oderId == userId);
    }
    
    // Check message participant (same logic but for messages)
    function isMessageParticipant(userId, participants) {
      return participants.size() > 0 && 
        (participants[0].oderId == userId || participants[1].oderId == userId);
    }
    
    // ========== USERS ==========
    
    match /users/{userId} {
      allow read: if isAuthenticated() && uid() == userId;
      allow update: if isAuthenticated() && uid() == userId;
      allow create: if false;
      allow delete: if false;
    }
    
    // ========== TRIPS ==========
    
    match /trips/{tripId} {
      allow read: if isAuthenticated() && 
        (resource.data.status == 'OPEN' || resource.data.driverId == uid());
      allow create: if isAuthenticated() && request.resource.data.driverId == uid();
      allow update: if isAuthenticated() && resource.data.driverId == uid();
      allow delete: if isAuthenticated() && resource.data.driverId == uid();
    }
    
    // ========== PASSENGER REQUESTS ==========
    
    match /passengerRequests/{requestId} {
      allow read: if isAuthenticated() && 
        (resource.data.status == 'OPEN' || resource.data.passengerId == uid());
      allow create: if isAuthenticated() && request.resource.data.passengerId == uid();
      allow update: if isAuthenticated() && resource.data.passengerId == uid();
      allow delete: if isAuthenticated() && resource.data.passengerId == uid();
    }
    
    // ========== CHAT ROOMS ==========
    
    match /chatRooms/{roomId} {
      allow read: if isAuthenticated() && 
        isInParticipants(uid(), resource.data.participants);
      allow create: if isAuthenticated() && 
        (request.resource.data.participants[0].oderId == uid() ||
         request.resource.data.participants[1].oderId == uid());
      allow update: if isAuthenticated() && 
        isInParticipants(uid(), resource.data.participants);
      allow delete: if false;
    }
    
    // ========== CHAT MESSAGES ==========
    
    match /chatMessages/{messageId} {
      allow read: if isAuthenticated() && 
        isMessageParticipant(uid(), get(/databases/$(database)/documents/chatRooms/$(resource.data.conversationId)).data.participants);
      allow create: if isAuthenticated() && request.resource.data.senderId == uid();
      allow update: if false;
      allow delete: if false;
    }
  }
}
