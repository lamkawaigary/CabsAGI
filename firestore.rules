rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function uid() {
      return request.auth.uid;
    }
    
    // ========== USERS ==========
    
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && uid() == userId;
    }
    
    // ========== LISTINGS (Carousell Model) ==========
    // Simple: OPEN → SOLD/CANCELLED
    // Allow public read for browsing (no auth required to see offers)

    match /listings/{listingId} {
      allow read: if true; // Public read for browsing
      allow create: if isAuthenticated() && request.resource.data.initiatorId == uid();
      allow update: if isAuthenticated() && (
        resource.data.initiatorId == uid() ||
        request.resource.data.buyerId == uid() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedParties', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && resource.data.initiatorId == uid() && resource.data.status == 'OPEN';
    }
    
    // ========== CHAT ROOMS ==========
    
    match /chatRooms/{roomId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false;
    }
    
    // ========== CHAT MESSAGES ==========
    
    match /chatMessages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == uid();
      allow update, delete: if false;
    }
    
    // ========== TRIPS (Driver Routes) ==========
    // Allow public read for browsing (no auth required)

    match /trips/{tripId} {
      allow read: if true; // Public read for browsing
      allow create: if isAuthenticated() && request.resource.data.driverId == uid();
      allow update: if isAuthenticated() && (
        resource.data.driverId == uid() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingPassengers', 'updatedAt', 'joinedTrips'])
      );
      allow delete: if isAuthenticated() && resource.data.driverId == uid();
    }
    
    // ========== PASSENGER REQUESTS ==========
    // Allow public read for browsing

    match /passengerRequests/{requestId} {
      allow read: if true; // Public read for browsing
      allow create: if isAuthenticated() && request.resource.data.passengerId == uid();
      allow update, delete: if isAuthenticated() && resource.data.passengerId == uid();
    }
    
    // ========== LEGACY COLLECTIONS ==========
    
    match /priceQuotes/{quoteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.status == 'pending';
      allow delete: if false;
    }
  }
}